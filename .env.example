# Copy to .env and fill in.
# .env is git-ignored.

# === Databricks ZeroBus connection ===
# Workspace URL, e.g. https://dbc-a1b2c3d4-e5f6.cloud.databricks.com
DATABRICKS_WORKSPACE_URL=

# ZeroBus gRPC endpoint, e.g. https://1234567890123456.zerobus.us-west-2.cloud.databricks.com
# (workspace-id . zerobus . region . cloud.databricks.com)
ZEROBUS_ENDPOINT=

# Service-principal OAuth client credentials (NOT a PAT)
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Fully-qualified target table: <catalog>.<schema>.<table>
ZEROBUS_TABLE=main.default.gw2_player_position

# === Tool behavior ===
# Poll rate in Hz. MumbleLink updates every game frame (~60Hz); 10Hz is plenty.
POLL_HZ=10

# Skip frames where uiTick has not advanced (true/false).
DEDUPE_BY_TICK=true

# Override the MumbleLink shared-memory location (rare; auto-detected per OS).
# Windows: name of the named shared memory section (default: MumbleLink)
# Linux:   path to the shared memory file       (default: /dev/shm/MumbleLink)
# MUMBLELINK_PATH=
